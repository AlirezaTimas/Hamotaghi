### 13) Sample Migration Snippets (Laravel)

**users migration (simplified):**

```php
Schema::create('users', function (Blueprint $table) {
    $table->bigIncrements('id');
    $table->string('email')->nullable()->unique();
    $table->string('phone')->nullable()->unique();
    $table->string('password');
    $table->enum('role',['owner','roommate'])->default('roommate');
    $table->enum('gender',['male','female'])->nullable();
    $table->boolean('first_login')->default(true);
    $table->boolean('is_active')->default(true);
    $table->timestamps();
});
```

**listings migration (simplified):**

```php
Schema::create('listings', function (Blueprint $table) {
    $table->bigIncrements('id');
    $table->unsignedBigInteger('owner_id');
    $table->string('title');
    $table->text('description')->nullable();
    $table->integer('price');
    $table->string('city');
    $table->text('address')->nullable();
    $table->integer('room_count')->default(1);
    $table->date('available_from')->nullable();
    $table->enum('gender_allowed', ['male','female','any'])->default('any');
    $table->json('rules')->nullable();
    $table->json('images')->nullable();
    $table->enum('status',['active','archived','deleted'])->default('active');
    $table->timestamps();

    $table->foreign('owner_id')->references('id')->on('users')->onDelete('cascade');
});
```

